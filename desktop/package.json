{
  "name": "rentradar-desktop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "RentRadar Austria desktop: saved searches scanned on demand, stored in a local SQLite DB",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "at.rentradar.desktop",
    "productName": "RentRadar Austria",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
