{
  "manifest_version": 3,
  "name": "RentRadar Austria",
  "version": "3.0.0",
  "description": "Every Austrian rental portal in one search. Duplicates merged, price drops tracked, all data kept private in your browser.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "RentRadar Austria",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*"],
      "js": ["landing.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.willhaben.at/*",
    "https://*.immobilienscout24.at/*",
    "https://immobilien.derstandard.at/*",
    "https://immo.sn.at/*",
    "https://*.findmyhome.at/*",
    "https://*.dibeo.at/*",
    "https://*.rentola.at/*",
    "https://*.wunderflats.com/*",
    "https://*.immomarktplatz.at/*",
    "https://*.immocontract.at/*",
    "https://*.lebenswert-wohnen.at/*",
    "https://*.novel-real.at/*",
    "https://*.wohnreich.at/*",
    "https://*.immovent.at/*",
    "https://*.realbrokers.at/*",
    "https://*.edlauer.com/*",
    "https://*.bwsg.at/*",
    "https://*.oevw.at/*",
    "https://*.nebau.at/*",
    "https://overpass-api.de/*",
    "https://overpass.private.coffee/*"
  ]
}
